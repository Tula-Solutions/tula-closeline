{
  "name": "__NAME__",
  "version": "0.0.0",
  "description": "__DESC__",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "prepare": "husky || true",
    "check": "biome check --no-errors-on-unmatched .",
    "typecheck": "echo 'nothing to typecheck yet'",
    "shared:check": "bash .claude/hooks/shared-check.sh",
    "verify": "bun run check && bun run shared:check",
    "verify:changed": "bun run verify"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "husky": "^9.1.7"
  }
}
