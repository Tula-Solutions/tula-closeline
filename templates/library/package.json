{
  "name": "__NAME__",
  "version": "0.1.0",
  "description": "__DESC__",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "files": ["dist"],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prepare": "husky || true",
    "build": "bunup",
    "check": "biome check src scripts",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "test:coverage": "bun test src --coverage",
    "dist:check": "bash scripts/dist-check.sh",
    "shared:check": "bash .claude/hooks/shared-check.sh",
    "precommit:dist": "bunup && git add dist",
    "verify": "bun run check && bun run typecheck && bun run test:coverage && bun run dist:check && bun run shared:check",
    "verify:changed": "biome check --changed --no-errors-on-unmatched src scripts && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "bun-types": "^1.4.2",
    "bunup": "^0.16.32",
    "husky": "^9.1.7",
    "typescript": "^7.0.2"
  }
}
